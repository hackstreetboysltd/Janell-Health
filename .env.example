# Janell Health — environment template (no secrets).
# Copy to .env and fill in values from your secret manager.

# --- Core ---
# Local Docker: both URLs are the same.
# Neon/Vercel: DATABASE_URL = pooled (PgBouncer); DIRECT_URL = unpooled (migrations).
DATABASE_URL=postgresql://carelink:carelink@localhost:5432/carelink
DIRECT_URL=postgresql://carelink:carelink@localhost:5432/carelink
AUTH_SECRET=
AUTH_URL=http://localhost:3000
NODE_ENV=development

# --- Auth ---
# Omit Google keys for local email continue flow
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Grant admin access: set User.role = ADMIN in the database, then sign in at /admin
PHONE_OTP_ENABLED=true
ALLOW_DEV_LOGIN=false

# --- Feature flags ---
VERIFICATION_REQUIRED=true

# --- SMS (Africa's Talking) ---
SMS_ENABLED=false
SMS_API_KEY=
AT_USERNAME=sandbox
AT_ENV=sandbox
SMS_SENDER_ID=JanellHlth
SMS_PROVIDER=africastalking

# --- M-Pesa (Daraja) ---
MPESA_ENV=sandbox
MPESA_MOCK=true
ALLOW_MPESA_MOCK=false
MPESA_CALLBACK_SECRET=
MPESA_CALLBACK_URL=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=

# --- File storage ---
# Vercel / multi-instance: must be s3 (R2 or AWS). Never local on serverless.
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Rate limiting (optional Upstash Redis) ---
# When both are set, API/OTP rate limits use Upstash instead of Postgres.
# Leave empty for local Docker / Railway — Postgres RateLimitHit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Upload malware scan (ClamAV / clamd) ---
# Production Docker/Railway: CLAMAV_ENABLED=true + clamd sidecar.
# Vercel: leave false (no TCP sidecar). Magic-byte checks still run.
CLAMAV_ENABLED=false
CLAMAV_REQUIRED=
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Observability (optional) ---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
# Source map upload (CI/production only — keep auth token in secret manager)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- API rate limiting ---
# Off in NODE_ENV=test unless set to true. Set false to disable in any environment.
API_RATE_LIMIT_ENABLED=
